    "@tailwindcss/vite": "4.3.3",
    "astro": "7.2.10",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.38.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "sharp": "0.35.3",
