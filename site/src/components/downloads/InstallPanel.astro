---
import InstallOptions from './InstallOptions';
import { getCatalog } from '../../lib/catalog';
import { withBase } from '../../lib/urls';
import { installMethods } from '../../lib/install-methods.mjs';

const catalog = getCatalog();
const methods = installMethods(catalog);
---
<div class="install-panel">
  <div class="js-enhanced-only"><InstallOptions client:load methods={methods} /></div>
  <a class="text-link" href={withBase('docs/development/')}>Read the source-build prerequisites <span aria-hidden="true">&rarr;</span></a>
  <div class="no-js-only">
    <div class="no-js-install">
      <p>All available installation commands:</p>
      {methods.map((method) => <p><strong>{method.label}:</strong> <code>{method.command}</code></p>)}
    </div>
  </div>
</div>
