---
import { ArrowUpRight, BookOpen } from 'lucide-react';
import MarketingLayout from '../layouts/MarketingLayout.astro';
import { withBase } from '../lib/urls';
---
<MarketingLayout title="That page has fizzled - Sodapop" noindex canonicalPath={withBase('404.html')}>
  <section class="not-found wrap">
    <p class="eyebrow">404 / a little flat</p>
    <h1>That page has fizzled.</h1>
    <p>No worries. There's plenty of pop elsewhere.</p>
    <div class="hero-ctas">
      <a class="button button-pink" href={withBase()}>Back to Sodapop <ArrowUpRight size={17} aria-hidden="true" /></a>
      <a class="button button-outline" href={withBase('docs/')}><BookOpen size={17} aria-hidden="true" />Find the docs</a>
    </div>
  </section>
</MarketingLayout>
