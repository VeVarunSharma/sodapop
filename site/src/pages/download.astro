---
import { ArrowUpRight, Download, FlaskConical, ShieldCheck } from 'lucide-react';
import MarketingLayout from '../layouts/MarketingLayout.astro';
import InstallPanel from '../components/downloads/InstallPanel.astro';
import Questions from '../components/downloads/Questions';
import { getCatalog } from '../lib/catalog';
import { withBase } from '../lib/urls';

const catalog = getCatalog();
const prerelease = catalog.mode === 'pre-release';
const windowsArtifact = catalog.artifacts.find((artifact) => artifact.platform === 'windows/amd64');
const windowsFilename = windowsArtifact?.archive ?? null;
if (windowsArtifact && (!windowsFilename || !windowsFilename.endsWith('.zip'))) {
  throw new Error('The Windows download catalog must contain a qualified ZIP archive');
}
---
<MarketingLayout title="Get Sodapop - Downloads and installation" description="Start here to install Sodapop, check platform and release availability, and open your first project.">
  <div class="wrap">
    <section class="download-intro">
      <p class="eyebrow">Bring a project. We'll meet you there.</p>
      <h1>Let's get Sodapop <br />into your terminal.</h1>
      <p>Pick the install that fits your machine, then launch Sodapop from your project directory. The commands and prerequisites are below.</p>
    </section>

    <section class="release-notice" aria-labelledby="release-status">
      {prerelease ? <FlaskConical size={25} aria-hidden="true" /> : <ShieldCheck size={25} aria-hidden="true" />}
      <div>
        <h2 id="release-status">{prerelease ? 'Still in the soda lab.' : `Sodapop ${catalog.version}`}</h2>
        <p>{prerelease ? 'Public binary downloads and package-manager installs are not enabled on this site yet. The source-build path is available for developers; it needs the prerequisites below.' : 'Download the archive for your operating system and processor. Compare its checksum before extracting the executable.'}</p>
        {!prerelease && catalog.releaseUrl && <a class="text-link" href={catalog.releaseUrl}>Read the release notes <ArrowUpRight size={14} aria-hidden="true" /></a>}
      </div>
    </section>

    {!prerelease && (
      <section class="native-downloads" aria-labelledby="native-title">
        <h2 id="native-title">Pick your platform</h2>
        <p class="integrity-note" style="margin-bottom:20px">Choose your processor explicitly. On a Mac, check About This Mac; on Linux, <code>uname -m</code> identifies the architecture.</p>
        <div class="native-list">
          {catalog.artifacts.map((artifact) => (
            <article class="native-card">
              <h3>{artifact.label}</h3><p>{artifact.format === 'zip' ? 'Portable ZIP' : 'Native tar.gz'}{artifact.platform.startsWith('linux/') && ' · Requires glibc'}</p>
              <a class="button button-small" href={artifact.archiveUrl}><Download size={16} aria-hidden="true" />Download archive</a>
              <a class="text-link" href={artifact.checksumUrl}>SHA-256 checksum</a>
            </article>
          ))}
        </div>
        <p class="integrity-note">Download the matching checksum sidecar into the same directory. On macOS, use <code>shasum -a 256 -c &lt;archive&gt;.sha256</code>; on Linux, use <code>sha256sum -c &lt;archive&gt;.sha256</code>. Only extract/install after verification succeeds. Hashes establish byte consistency, not publisher identity by themselves; review the release provenance separately. <a class="text-link" href={withBase('docs/installation/')}>Full installation instructions</a>.</p>
        {windowsFilename && <p class="integrity-note">On Windows, compare <code>{`Get-FileHash -Algorithm SHA256 ".\\${windowsFilename}"`}</code> with the published checksum. After successful verification, use <code>{`Expand-Archive ".\\${windowsFilename}" -DestinationPath ".\\sodapop"`}</code> and follow the guide to put the extracted executable on PATH.</p>}
        {catalog.manifestUrl && <p class="integrity-note"><a class="text-link" href={catalog.manifestUrl}>Release manifest and binary hashes</a></p>}
      </section>
    )}

    <section class="download-grid" aria-label="Install and launch">
      <div>
        <InstallPanel />
        <p class="integrity-note">Source builds use the existing Sodapop public OAuth client configuration. Do not borrow another application's credentials or put tokens in project files.</p>
      </div>
      <div class="download-guide">
        <h2>From download to first prompt</h2>
        <ol>
          <li><strong>Get the app</strong>{prerelease ? 'Read the build prerequisites and create a local build from a source checkout.' : 'Install a verified package or put the extracted executable in a directory on your PATH.'}</li>
          <li><strong>Open a project</strong>Launch <code>sodapop</code> from the directory you want to work in.</li>
          <li><strong>Bring your account</strong>Run <code>/login</code> and authorize in your browser. You need an eligible GitHub account with Copilot access.</li>
          <li><strong>Choose a model and try a request</strong>Pick an available model, describe a small task, and review tool requests before approving them.</li>
        </ol>
        <a class="text-link" style="margin-top:25px" href={withBase('docs/getting-started/')}>The getting-started guide <ArrowUpRight size={16} aria-hidden="true" /></a>
      </div>
    </section>

    <section class="compatibility" aria-labelledby="platform-title">
      <h2 id="platform-title">Supported platforms</h2>
      <div class="table-scroll" tabindex="0" role="region" aria-label="Supported platforms">
        <table>
          <thead><tr><th scope="col">Platform</th><th scope="col">Processors</th><th scope="col">Distribution design</th></tr></thead>
          <tbody>
            <tr><th scope="row">macOS</th><td>Apple silicon / Intel</td><td>Native archive, Homebrew, npm</td></tr>
            <tr><th scope="row">Linux</th><td>ARM64 / x64, glibc</td><td>Native archive, Homebrew, npm</td></tr>
            <tr><th scope="row">Windows</th><td>x64</td><td>Native ZIP; npm when included in the published release</td></tr>
          </tbody>
        </table>
      </div>
      <p>This table describes supported build targets, not a claim that every channel is published. npm installs only the native platforms declared by that published package version; Windows requires its qualified ZIP payload. Node.js is required for the npm launcher. Native downloads and Homebrew do not require Go or a separate Copilot installation. Windows ARM64 and musl-based Linux are not supported targets.</p>
    </section>
    <section class="faq-section" aria-labelledby="questions-title">
      <h2 id="questions-title">Before your first prompt</h2>
      <div class="js-enhanced-only"><Questions client:visible /></div>
      <div class="no-js-only"><p>Read the <a class="text-link" href={withBase('docs/permissions-and-privacy/')}>permissions and privacy guide</a> for account requirements, approvals, and the limits of cancellation.</p></div>
    </section>
  </div>
</MarketingLayout>
