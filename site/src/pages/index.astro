---
import { ArrowUpRight, BookOpen, Braces, Palette, Pause, Play, ShieldCheck, Sparkles, Terminal } from 'lucide-react';
import MarketingLayout from '../layouts/MarketingLayout.astro';
import DemoFrame from '../components/media/DemoFrame.astro';
import InstallPanel from '../components/downloads/InstallPanel.astro';
import { getCatalog } from '../lib/catalog';
import { withBase } from '../lib/urls';
const catalog = getCatalog();
const prerelease = catalog.mode === 'pre-release';
const docs = [
  { title: 'First sip', text: 'Install, sign in, and settle into your first conversation.', href: 'docs/getting-started/', icon: Sparkles },
  { title: 'Know your commands', text: 'The shortcuts and little helpers that keep things flowing.', href: 'docs/commands/', icon: Terminal },
  { title: 'Make it yours', text: 'Find your theme, your colors, and your level of fizz.', href: 'docs/customization/', icon: Palette },
  { title: 'Stay in control', text: 'Understand approvals, planning, and your project boundaries.', href: 'docs/permissions-and-privacy/', icon: ShieldCheck },
];
---
<MarketingLayout>
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">A fresh take on your terminal</p>
      <h1 id="hero-title">Your terminal.<br />With a little<br /><em>more pop.</em></h1>
      <p class="hero-lede">A colorful coding companion powered by GitHub Copilot. Real tools, clear approvals, and a terminal that feels a little more you.</p>
      <div class="hero-ctas">
        <a class="button button-pink" href={withBase('download/')}>
          {prerelease ? 'Get Sodapop' : 'Download Sodapop'} <ArrowUpRight size={18} aria-hidden="true" />
        </a>
        <a class="button button-outline" href={withBase('docs/')}><BookOpen size={17} aria-hidden="true" /> Read the docs</a>
      </div>
      <p class="hero-meta"><span class="status-dot" aria-hidden="true"></span>{prerelease ? 'Pre-release · Source builds available' : `Version ${catalog.version}`}<span aria-hidden="true">/</span> macOS, Linux &amp; Windows x64</p>
      <button class="motion-toggle utility-button hero-motion" type="button" aria-pressed="false">
        <Pause className="pause-icon" size={13} aria-hidden="true" /><Play className="play-icon" size={13} aria-hidden="true" /><span data-motion-label>Pause bubbles</span>
      </button>
    </div>
    <div class="hero-art">
      <div class="mascot-disc" aria-hidden="true"></div>
      <span class="bubble b1" aria-hidden="true"></span><span class="bubble b2" aria-hidden="true"></span><span class="bubble b3" aria-hidden="true"></span><span class="bubble b4" aria-hidden="true"></span><span class="bubble b5" aria-hidden="true"></span>
      <span class="floating-tag tag-top"><Sparkles size={14} aria-hidden="true" /> Small delights, built in.</span>
      <img class="hero-mascot" src={withBase('assets/brand/sodapop-mascot.webp')} width="1200" height="1200" alt="Sodapop's smiling soda-can mascot waves hello." fetchpriority="high" />
      <span class="floating-tag tag-bottom"><ShieldCheck size={16} aria-hidden="true" /> Your project. Your call.</span>
      <span class="floating-tag tag-small">SERIOUS TOOLS.<br />LESS SERIOUS VIBES.</span>
    </div>
  </section>

  <div class="ingredient-strip wrap">
    <p>A few good ingredients</p>
    <span><Braces size={19} aria-hidden="true" /> Copilot SDK at the core</span>
    <span><ShieldCheck size={19} aria-hidden="true" /> Explicit approvals</span>
    <span><Palette size={19} aria-hidden="true" /> A splash of personality</span>
  </div>

  <section class="section wrap" id="in-action" aria-labelledby="action-title">
    <div class="section-heading">
      <div><p class="eyebrow">Take a peek inside</p><h2 id="action-title">Comfortably familiar.<br />Refreshingly different.</h2></div>
      <p>A conversation, your project, and the tools you need. All together in one happy little terminal.</p>
    </div>
    <DemoFrame name="overview" title="A peek inside Sodapop" />
  </section>

  <section class="features-section wrap" id="features" aria-label="The good stuff">
    <article class="story">
      <div class="story-copy">
        <p class="eyebrow"><Terminal size={14} aria-hidden="true" /> Keep your flow</p>
        <h2>Less hunting.<br />More doing.</h2>
        <p>Type <strong>/</strong> and find your way. Discover commands, pick a model, switch into advisory planning, or come back to a saved conversation.</p>
        <div class="feature-notes"><span>/help</span><span>/plan</span><span>/resume</span></div>
        <a class="text-link" href={withBase('docs/commands/')}>Meet the command palette <ArrowUpRight size={16} aria-hidden="true" /></a>
      </div>
      <DemoFrame name="commands" title="Commands and planning" caption="Command discovery and advisory planning, recorded in a local fixture project." />
    </article>

    <article class="story story-reverse story-tone">
      <div class="story-copy">
        <p class="eyebrow"><Palette size={14} aria-hidden="true" /> Find your flavor</p>
        <h2>Make yourself<br />at home.</h2>
        <p>Neon or understated. Playful or quiet. Choose a theme, adjust the personality, and keep color, motion, and ASCII preferences on your terms.</p>
        <div class="swatch-row" aria-hidden="true"><span style="background:#fb7185"></span><span style="background:#c084fc"></span><span style="background:#67e8f9"></span><span style="background:#30303d"></span><span style="background:#f4f4f5"></span></div>
        <a class="text-link" href={withBase('docs/customization/')}>Find your kind of fizz <ArrowUpRight size={16} aria-hidden="true" /></a>
      </div>
      <DemoFrame name="themes" title="A theme for your mood" caption="Neon Arcade, Graphite, and Daylight in the real Sodapop interface." />
    </article>

    <article class="story">
      <div class="story-copy">
        <p class="eyebrow"><ShieldCheck size={14} aria-hidden="true" /> You keep the wheel</p>
        <h2>Your project.<br />Your call.</h2>
        <p>See the working-tree diff without changing it. Approve edits and shell commands explicitly. Know what planning and cancellation do&mdash;and what they don't.</p>
        <a class="text-link" href={withBase('docs/permissions-and-privacy/')}>Understand the boundaries <ArrowUpRight size={16} aria-hidden="true" /></a>
      </div>
      <DemoFrame name="diff" title="A clearer view of changes" caption="Read-only inspection of prepared staged and unstaged changes. No automatic rollback." />
    </article>
  </section>

  <section class="install-section wrap" aria-labelledby="install-title">
    <div class="install-copy">
      <p class="eyebrow">Ready when you are</p>
      <h2 id="install-title">Pop it open.</h2>
      <p>{prerelease ? "We're preparing the first public downloads. In the meantime, explore the source-build path and get to know the app." : 'Choose your installation method, open a project, and make yourself at home.'}</p>
      <a class="text-link" style="margin-top:18px" href={withBase('download/')}>All installation details <ArrowUpRight size={16} aria-hidden="true" /></a>
    </div>
    <InstallPanel />
  </section>

  <section class="section docs-doorway wrap" aria-labelledby="docs-title">
    <div class="section-heading">
      <div><p class="eyebrow">A little guidance goes a long way</p><h2 id="docs-title">No mystery ingredients.</h2></div>
      <a class="text-link" href={withBase('docs/')}>Explore the docs <ArrowUpRight size={16} aria-hidden="true" /></a>
    </div>
    <div class="docs-links">
      {docs.map(({ title, text, href, icon: Icon }) => (
        <a class="docs-link" href={withBase(href)}>
          <Icon aria-hidden="true" /><h3>{title} <ArrowUpRight size={16} aria-hidden="true" /></h3><p>{text}</p>
        </a>
      ))}
    </div>
  </section>
  <section class="closing wrap" aria-labelledby="closing-title">
    <div><h2 id="closing-title">Good tools. A little joy.</h2><p>There's room for both in your terminal.</p></div>
    <a class="button" href={withBase('download/')}>Get Sodapop <ArrowUpRight size={18} aria-hidden="true" /></a>
  </section>
</MarketingLayout>
