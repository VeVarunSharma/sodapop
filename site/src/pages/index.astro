---
import { ArrowUpRight, BookOpen, Braces, Palette, Pause, Play, ShieldCheck, Sparkles, Terminal } from 'lucide-react';
import MarketingLayout from '../layouts/MarketingLayout.astro';
import DemoFrame from '../components/media/DemoFrame.astro';
import InstallPanel from '../components/downloads/InstallPanel.astro';
import { getCatalog } from '../lib/catalog';
import { withBase } from '../lib/urls';
const catalog = getCatalog();
const prerelease = catalog.mode === 'pre-release';
const publishedPreview = catalog.mode === 'release' && catalog.version.includes('-');
const docs = [
  { title: 'First sip', text: 'Install, sign in, and try one small request in your project.', href: 'docs/getting-started/', icon: Sparkles },
  { title: 'Pick a workflow', text: 'Fizz up options, taste-test changes, or browse the vending machine.', href: 'docs/commands/#built-in-workflows', icon: Terminal },
  { title: 'Connect the extras', text: 'Add explicit MCP servers and trusted project skills. Nothing ambient sneaks in.', href: 'docs/commands/#connect-and-extend', icon: Braces },
  { title: 'Approvals and privacy', text: 'Learn what needs approval, what stays saved, and what cancellation does.', href: 'docs/permissions-and-privacy/', icon: ShieldCheck },
];
---
<MarketingLayout>
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">Your repo called. It ordered something fizzy.</p>
      <h1 id="hero-title">Let's make <br /><em>something pop.</em></h1>
      <p class="hero-lede">An independent terminal coding companion powered by the GitHub Copilot SDK. Explore your code, compare approaches, taste-test the changes, and inspect the diff. The smiling can is coming too.</p>
      <div class="hero-ctas">
        <a class="button button-pink" href={withBase('download/')}>
          {prerelease ? 'Get Sodapop' : 'Download Sodapop'} <ArrowUpRight size={18} aria-hidden="true" />
        </a>
        <a class="button button-outline" href={withBase('docs/')}><BookOpen size={17} aria-hidden="true" /> Read the docs</a>
      </div>
      <p class="hero-meta"><span class="status-dot" aria-hidden="true"></span>{prerelease ? 'Pre-release · Source builds available' : `${publishedPreview ? 'Preview' : 'Version'} ${catalog.version}`}<span aria-hidden="true">/</span> macOS, Linux &amp; Windows x64</p>
      <button class="motion-toggle utility-button hero-motion" type="button" aria-pressed="false">
        <Pause className="pause-icon" size={13} aria-hidden="true" /><Play className="play-icon" size={13} aria-hidden="true" /><span data-motion-label>Pause bubbles</span>
      </button>
    </div>
    <div class="hero-art">
      <div class="mascot-disc" aria-hidden="true"></div>
      <span class="bubble b1" aria-hidden="true"></span><span class="bubble b2" aria-hidden="true"></span><span class="bubble b3" aria-hidden="true"></span><span class="bubble b4" aria-hidden="true"></span><span class="bubble b5" aria-hidden="true"></span>
      <span class="floating-tag tag-top"><Sparkles size={14} aria-hidden="true" /> Pairs well with side projects.</span>
      <img class="hero-mascot" src={withBase('assets/brand/sodapop-mascot.webp')} width="1200" height="1200" alt="Sodapop's smiling soda-can mascot waves hello." fetchpriority="high" />
      <span class="floating-tag tag-bottom"><ShieldCheck size={16} aria-hidden="true" /> Your project. Your call.</span>
      <span class="floating-tag tag-small">BEST SERVED<br />IN A TERMINAL.</span>
    </div>
  </section>

  <div class="ingredient-strip wrap">
    <p>What's in the can?</p>
    <span><Braces size={19} aria-hidden="true" /> GitHub Copilot SDK</span>
    <span><ShieldCheck size={19} aria-hidden="true" /> Explicit approvals</span>
    <span><Sparkles size={19} aria-hidden="true" /> Workflows, tools &amp; skills</span>
  </div>

  <section class="section wrap" id="in-action" aria-labelledby="action-title">
    <div class="section-heading">
      <div><p class="eyebrow">Pull up a terminal</p><h2 id="action-title">Let's poke around <br />your repo.</h2></div>
      <p>Meet the command palette, cycle through Chat, Plan, and Autopilot, and inspect a prepared working-tree diff in this signed-out tour.</p>
    </div>
    <DemoFrame name="overview" title="A peek inside Sodapop" />
  </section>

  <section class="features-section wrap" id="features" aria-label="The good stuff">
    <article class="story">
      <div class="story-copy">
        <p class="eyebrow"><Terminal size={14} aria-hidden="true" /> Pick a can</p>
        <h2>Ideas, checks, settings. <br />One vending machine.</h2>
        <p>Open <strong>/vending-machine</strong> for a curated menu. Use <strong>/fizz</strong> to compare approaches, <strong>/taste-test</strong> to validate conversation changes, or jump to models, themes, MCP servers, and project skills.</p>
        <div class="feature-notes"><span>/vending-machine</span><span>/fizz</span><span>/taste-test</span></div>
        <a class="text-link" href={withBase('docs/commands/#built-in-workflows')}>See the built-in workflows <ArrowUpRight size={16} aria-hidden="true" /></a>
      </div>
      <DemoFrame name="commands" title="Commands and workflows" />
    </article>

    <article class="story story-reverse story-tone">
      <div class="story-copy">
        <p class="eyebrow"><ShieldCheck size={14} aria-hidden="true" /> A little less "probably works"</p>
        <h2>Taste-test it. <br />Then take a look.</h2>
        <p>Use <strong>/diff session</strong> for changes observed since the conversation baseline, or <strong>/diff</strong> for the whole working tree. Taste Test reports what passed, failed, and stayed unverified without automatically fixing anything.</p>
        <div class="feature-notes"><span>/diff session</span><span>/taste-test</span><span>UNVERIFIED means unverified</span></div>
        <a class="text-link" href={withBase('docs/commands/#conversation-model-and-change-controls')}>See how the evidence works <ArrowUpRight size={16} aria-hidden="true" /></a>
      </div>
      <DemoFrame name="diff" title="A clearer view of changes" />
    </article>

    <article class="story">
      <div class="story-copy">
        <p class="eyebrow"><Palette size={14} aria-hidden="true" /> Find your flavor</p>
        <h2>How fizzy <br />are we feeling?</h2>
        <p>Go neon with Neon Arcade, or keep it understated with Graphite. Set the personality to Quiet, Playful, or Extra; color, motion, and ASCII settings are independent.</p>
        <div class="swatch-row" aria-hidden="true"><span style="background:#fb7185"></span><span style="background:#c084fc"></span><span style="background:#67e8f9"></span><span style="background:#30303d"></span><span style="background:#f4f4f5"></span></div>
        <a class="text-link" href={withBase('docs/customization/')}>Explore themes and personality <ArrowUpRight size={16} aria-hidden="true" /></a>
      </div>
      <DemoFrame name="themes" title="A theme for your mood" />
    </article>
  </section>

  <section class="install-section wrap" aria-labelledby="install-title">
    <div class="install-copy">
      <p class="eyebrow">Got a project in mind?</p>
      <h2 id="install-title">Pop it open.</h2>
      <p>{prerelease ? "Public downloads aren't enabled here yet. You can build from source with the documented prerequisites." : 'Choose an installation method, open your project directory, and launch Sodapop.'}</p>
      <a class="text-link" style="margin-top:18px" href={withBase('download/')}>All installation details <ArrowUpRight size={16} aria-hidden="true" /></a>
    </div>
    <InstallPanel />
  </section>

  <section class="section docs-doorway wrap" aria-labelledby="docs-title">
    <div class="section-heading">
      <div><p class="eyebrow">Start here, or skip to what you need</p><h2 id="docs-title">No mystery ingredients.</h2></div>
      <a class="text-link" href={withBase('docs/')}>Explore the docs <ArrowUpRight size={16} aria-hidden="true" /></a>
    </div>
    <div class="docs-links">
      {docs.map(({ title, text, href, icon: Icon }) => (
        <a class="docs-link" href={withBase(href)}>
          <Icon aria-hidden="true" /><h3>{title} <ArrowUpRight size={16} aria-hidden="true" /></h3><p>{text}</p>
        </a>
      ))}
    </div>
  </section>
  <section class="closing wrap" aria-labelledby="closing-title">
    <div><h2 id="closing-title">Got a "what if"?</h2><p>Sodapop's up for a little tinkering.</p></div>
    <a class="button" href={withBase('download/')}>Get Sodapop <ArrowUpRight size={18} aria-hidden="true" /></a>
  </section>
</MarketingLayout>
